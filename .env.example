# Token bot Discord (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Application ID bot (Developer Portal > General Information)
CLIENT_ID=your_application_id_here

# (Opsional) ID server untuk registrasi command instan.
# Kosongkan untuk registrasi global (bisa sampai 1 jam).
GUILD_ID=

# User ID owner yang boleh memakai command, pisahkan dengan koma.
# Contoh: 123456789012345678,987654321098765432
OWNER_IDS=your_user_id_here

# (Opsional) Warna default embed. Default: #5865F2
EMBED_COLOR=#5865F2

# ---------------------------- AUTO-REPLY ------------------------------------
# API key Gemini (Google AI Studio). Dibutuhkan untuk jawaban AI.
GEMINI_API_KEY=

# Model Gemini. Default: gemini-3.5-flash (free tier)
GEMINI_MODEL=gemini-3.5-flash

# Aktifkan auto-reply (true/false). Default: true
AUTOREPLY_ENABLED=true

# Batasi ke channel tertentu (ID, pisah koma). Kosong = semua channel.
AUTOREPLY_CHANNELS=

# Jeda anti-spam per user & per channel (milidetik). Default: 5000
AUTOREPLY_COOLDOWN_MS=5000

# Batas panjang pertanyaan yang dikirim ke Gemini. Default: 500
AUTOREPLY_MAX_LEN=500

# ID channel get-key & get-script, untuk token {get-key} / {get-script}.
CHANNEL_GET_KEY=
CHANNEL_GET_SCRIPT=

# ID channel support-game & support-executor, untuk token
# {support-game} / {support-executor}.
CHANNEL_SUPPORT_GAME=
CHANNEL_SUPPORT_EXECUTOR=

# ------------------------- PANEL LIVE /games --------------------------------
# (Opsional) ID channel tempat panel "Roox Hub · Supported Games" dikirim.
# Kosong = pakai CHANNEL_SUPPORT_GAME, atau channel tempat /games panel dipakai.
CHANNEL_GAMES=

# (Opsional) ID channel default untuk panel teks `freemium` (lihat /panel).
CHANNEL_FREEMIUM=

# (Opsional) Folder penyimpanan data runtime panel live: state.json + gambar
# upload (assets/). Default: data
# Di Railway, isi dengan path volume (mis. /data) agar data bertahan saat redeploy.
DATA_DIR=

# ---------------------------- SISTEM TIKET -----------------------------------
# (Opsional) ID kategori tiket. Biasanya cukup `/ticket setup category:#Premium`.
TICKET_CATEGORY_ID=

# (Opsional) Nama kategori yang dicari otomatis kalau belum di-setup. Default: Premium
TICKET_CATEGORY_NAME=Premium

# (Opsional) Role tambahan yang selalu boleh melihat tiket (ID, pisah koma).
# Semua role yang punya izin Manage Channels otomatis ikut jadi staff.
TICKET_STAFF_ROLES=

# (Opsional) Role yang di-ping setiap tiket baru dibuat.
TICKET_PING_ROLE_ID=

# (Opsional) Jeda minimal antar pembuatan tiket per user (ms). Default: 30000
TICKET_COOLDOWN_MS=30000

# (Opsional) Diisi otomatis oleh Railway. Jangan diubah manual.
# PORT=3000
